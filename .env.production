# ===== Database =====
DB_NAME=mcxx_chat
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===== Redis =====
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ===== Server =====
SERVER_PORT=8080

# ===== Logging =====
SHOW_SQL=false
LOG_LEVEL_SECURITY=WARN

# ===== JWT Authentication =====
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET_AT_LEAST_32_BYTES

JWT_ACCESS_EXP_SECONDS=3600
JWT_REFRESH_EXP_SECONDS=604800

# ===== AWS S3 Storage =====
AWS_S3_REGION=ap-southeast-2
AWS_S3_BUCKET_NAME=mcxx-chat
AWS_S3_ACCESS_KEY=your_access_key
AWS_S3_SECRET_KEY=your_secret_key
AWS_S3_ENDPOINT_OVERRIDE=
AWS_S3_MAX_FILE_SIZE=5242880

{
  "info": {
    "name": "mcxx-chat / User Relations",
    "_postman_id": "mcxx-user-relations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Get Relations",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/user-relations?status=FRIEND&relationId=",
          "query": [
            {
              "key": "status",
              "value": "FRIEND",
              "description": "Lọc theo trạng thái: PENDING | FRIEND | BLOCKED"
            },
            {
              "key": "relationId",
              "value": "",
              "description": "Optional. UUID của relation cuối cùng từ trang trước (cursor-based pagination)."
            }
          ]
        },
        "description": "Lấy danh sách quan hệ của user đang đăng nhập theo trạng thái."
      }
    },
    {
      "name": "Get My Sent Requests",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/user-relations/my-requests?relationId=",
          "query": [
            {
              "key": "relationId",
              "value": "",
              "description": "Optional. UUID của relation cuối cùng từ trang trước (cursor-based pagination)."
            }
          ]
        },
        "description": "Lấy danh sách lời mời kết bạn mà user đang đăng nhập đã gửi (trạng thái PENDING)."
      }
    },
    {
      "name": "Send Friend Request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/user-relations",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetId\": \"{{userId}}\"\n}"
        },
        "description": "Gửi lời mời kết bạn đến một user khác."
      }
    },
    {
      "name": "Accept Friend Request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/user-relations/accept",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetId\": \"{{userId}}\"\n}"
        },
        "description": "Chấp nhận lời mời kết bạn từ một user (targetId là người đã gửi lời mời)."
      }
    },
    {
      "name": "Unfriend",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/user-relations/unfriend",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetId\": \"{{userId}}\"\n}"
        },
        "description": "Hủy kết bạn với một user."
      }
    },
    {
      "name": "Block User",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/user-relations/block",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetId\": \"{{userId}}\"\n}"
        },
        "description": "Chặn một user. User bị chặn sẽ không thể gửi tin nhắn hay kết bạn."
      }
    },
    {
      "name": "Unblock User",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/user-relations/unblock",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetId\": \"{{userId}}\"\n}"
        },
        "description": "Bỏ chặn một user."
      }
    }
  ]
}

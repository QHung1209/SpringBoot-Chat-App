{
  "info": {
    "name": "mcxx-chat / Auth",
    "_postman_id": "mcxx-auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.data) {",
              "  pm.environment.set('accessToken',  res.data.accessToken);",
              "  pm.environment.set('refreshToken', res.data.refreshToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "X-Device-Id",   "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890", "description": "Optional. UUID của device. Tự sinh nếu không truyền." },
          { "key": "X-Device-Name", "value": "Chrome on Windows", "description": "Optional" },
          { "key": "X-OS",          "value": "Windows",           "description": "Optional" },
          { "key": "X-Browser",     "value": "Chrome",            "description": "Optional" },
          { "key": "X-IP-Address",  "value": "127.0.0.1",         "description": "Optional" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"johndoe123\",\n  \"password\": \"password123\",\n  \"fullName\": \"John Doe\",\n  \"email\": \"john@example.com\"\n}"
        },
        "description": "Đăng ký tài khoản mới.\n\n**Validation:**\n- username: 8–255 ký tự\n- password: 8–255 ký tự\n- fullName: 6–255 ký tự\n- email: định dạng email hợp lệ"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.data) {",
              "  pm.environment.set('accessToken',  res.data.accessToken);",
              "  pm.environment.set('refreshToken', res.data.refreshToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "X-Device-Id",   "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890", "description": "Optional" },
          { "key": "X-Device-Name", "value": "Chrome on Windows", "description": "Optional" },
          { "key": "X-OS",          "value": "Windows",           "description": "Optional" },
          { "key": "X-Browser",     "value": "Chrome",            "description": "Optional" },
          { "key": "X-IP-Address",  "value": "127.0.0.1",         "description": "Optional" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"johndoe123\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "Refresh Tokens",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.data) {",
              "  pm.environment.set('accessToken',  res.data.accessToken);",
              "  pm.environment.set('refreshToken', res.data.refreshToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "url": "{{baseUrl}}/auth/refresh",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "description": "Lấy cặp token mới bằng refreshToken. Không cần Bearer header."
      }
    },
    {
      "name": "Logout (current device)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/me/logout",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "description": "Đăng xuất thiết bị hiện tại (vô hiệu hóa token của device đang dùng)."
      }
    },
    {
      "name": "Logout All Devices",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/me/logout-all",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "description": "Đăng xuất tất cả thiết bị (vô hiệu hóa toàn bộ token của user)."
      }
    },
    {
      "name": "Get My Devices",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/me/devices",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "description": "Lấy danh sách thiết bị đang đăng nhập."
      }
    },
    {
      "name": "Kick Device",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/auth/me/devices/:deviceId",
          "variable": [{ "key": "deviceId", "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890", "description": "UUID của device cần kick" }]
        },
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "description": "Đăng xuất (kick) một thiết bị cụ thể theo deviceId."
      }
    }
  ]
}

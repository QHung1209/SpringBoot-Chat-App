# ===== Server Configuration =====
SERVER_PORT=8080

# ===== PostgreSQL Database =====
DB_URL=jdbc:postgresql://localhost:5432/mcxx_chat
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ===== Redis Cache =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Logging & Debug =====
SHOW_SQL=true
LOG_LEVEL_SECURITY=DEBUG

# ===== JWT Authentication =====
JWT_SECRET=your_jwt_secret_key_here_32_bytes_minimum_length_example
JWT_ACCESS_EXP_SECONDS=3600
JWT_REFRESH_EXP_SECONDS=604800
